{
  "name": "@gooftoken/remote-control",
  "version": "0.1.0",
  "description": "Dual-mode remote control plugin for DeepSeek Harness with Signal-style E2EE sessions and full WebUI tunneling.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "icon": "./assets/icon-180.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "e2ee",
    "wechat-miniprogram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparkjokerben/remote-control.git"
  },
  "homepage": "https://github.com/sparkjokerben/remote-control#readme",
  "engines": {
    "node": ">=22.21.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0 || >=0.2.3-alpha.1 <0.3.0-0 || >=0.3.0-rc.1 <1.0.0-0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "require": "./lib/client.cjs",
      "import": "./lib/client.cjs",
      "default": "./lib/client.cjs"
    },
    "./crypto": "./src/crypto/index.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": false
    }
  },
  "files": [
    "lib",
    "src/crypto",
    "cordis.patch.yml",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "pack:release": "node ./scripts/pack-release.mjs",
    "test:dist": "node ./scripts/smoke-client-entry.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0 || >=0.2.3-alpha.1 <0.3.0-0 || >=0.3.0-rc.1 <1.0.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.0",
    "react": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
